# 复制为 server/.env 后按需修改。所有项都有缺省值，不配置也能启动。
SHEDGUARD_DATA_DIR=./data
# 留空则由 DATA_DIR 派生 sqlite:///<data_dir>/shedguard.db
# SHEDGUARD_DB_URL=sqlite:///./data/shedguard.db
SHEDGUARD_HOST=127.0.0.1
SHEDGUARD_PORT=8000
SHEDGUARD_MAX_UPLOAD_BYTES=10485760
SHEDGUARD_TIMEZONE=Asia/Shanghai
SHEDGUARD_CAPTURE_HOUR=20
SHEDGUARD_CAPTURE_WINDOW_MINUTES=180
# ONNX 检测模型路径，留空则用空检测器（整图当身体，仅供联调）
# SHEDGUARD_DETECTOR_MODEL=../ml/models/gecko-det.onnx
SHEDGUARD_DETECT_MIN_CONFIDENCE=0.35
SHEDGUARD_BACKGROUND_DAYS=7
# 判定层：基线回看天数、最少样本数、越界阈值、触发所需命中数与连续天数
SHEDGUARD_BASELINE_DAYS=14
SHEDGUARD_MIN_BASELINE_SAMPLES=7
SHEDGUARD_ROBUST_Z_THRESHOLD=2.0
SHEDGUARD_ALERT_MIN_SIGNALS=2
SHEDGUARD_ALERT_CONSECUTIVE_DAYS=2
# 蜕皮状态识别：分类模型路径、降级阈值、裁剪外扩比例
# 模型旁必须有同名 .labels.json 记录类别顺序，否则加载失败
# SHEDGUARD_STATE_MODEL=../ml/models/gecko-state.onnx
SHEDGUARD_STATE_MIN_CONFIDENCE=0.6
SHEDGUARD_STATE_CROP_PADDING=0.08
# 上传后自动跑指标与状态判定，并在「正在蜕皮」时生成提醒
SHEDGUARD_AUTO_PROCESS=true
# 推送：关闭时提醒仍入库但标记 skipped（离线/局域网部署可关）
SHEDGUARD_PUSH_ENABLED=true
SHEDGUARD_EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
SHEDGUARD_PUSH_TIMEOUT_SECONDS=5.0
SHEDGUARD_ALERT_COOLDOWN_HOURS=24
# 鉴权：匿名账号令牌；关闭后所有请求以内置 dev 用户运行（仅本地调试用）
SHEDGUARD_AUTH_ENABLED=true
# 固件上传的共享设备令牌；留空则不校验（会记 WARNING）
SHEDGUARD_DEVICE_TOKEN=
# 设备健康兜底：离线/长时间未检出守宫时生成提醒
SHEDGUARD_HEALTH_MONITOR_ENABLED=true
SHEDGUARD_HEALTH_SCAN_MINUTES=10
SHEDGUARD_DEVICE_SILENCE_HOURS=6
SHEDGUARD_NO_DETECTION_STREAK=5
SHEDGUARD_CAPTURE_START_HOUR=8
SHEDGUARD_CAPTURE_END_HOUR=20
SHEDGUARD_LOG_LEVEL=INFO
SHEDGUARD_LOG_FORMAT=json